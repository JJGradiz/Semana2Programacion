<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="320.0" spacing="15.0" style="-fx-background-color: #FAFAFA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.sistemaacademico.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Label fx:id="lblMiEtiqueta" />
            <Label fx:id="welcomeText" text="UAM University" textFill="#3ad4c2">
                <font>
                    <Font name="Arial Bold" size="24.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <Label text="Ingresa tus credenciales" textFill="#262626">
        <font>
            <Font name="System Bold" size="13.0" />
        </font>
    </Label>

    <TextField fx:id="txtUsuario" alignment="CENTER" maxWidth="180.0" promptText="Usuario o Correo" />
    <PasswordField fx:id="txtClave" alignment="CENTER" maxWidth="180.0" promptText="Contraseña" />

    <Label fx:id="lblMensaje" textFill="RED">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button onAction="#btnConfirmar" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #3ad4c2; -fx-text-fill: white;" text="Iniciar" />
            <Button onAction="#btnLimpiar" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #DBDBDB; -fx-text-fill: black;" text="Limpiar" />
        </children>
    </HBox>
</VBox>
