<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="306.0" prefWidth="352.0" spacing="20.0" style="-fx-background-color: #1acfd5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.sesion4.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox alignment="TOP_CENTER" prefHeight="53.0" prefWidth="233.0" spacing="20.0">
      <children>
         <Label fx:id="lblMiEtiqueta" />
          <Label fx:id="welcomeText" prefHeight="21.0" prefWidth="190.0" text="UAM Class Registro" textAlignment="CENTER" textFill="WHITE">
            <font>
               <Font name="Arial Bold" size="18.0" />
            </font>
            <HBox.margin>
               <Insets top="12.0" />
            </HBox.margin>
         </Label>
      </children>
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
   </HBox>
   <Label text="Ingresa tus credenciales" textFill="WHITE">
      <font>
         <Font name="System Bold" size="13.0" />
      </font>
   </Label>
   <PasswordField fx:id="txtUsuario" alignment="CENTER" maxWidth="130.0" prefWidth="130.0" promptText="Usuario" />
   <PasswordField fx:id="txtClave" alignment="CENTER" maxWidth="130.0" prefWidth="130.0" promptText="Contraseña" />
   <Label fx:id="lblMensaje" textFill="RED">
      <font>
         <Font name="System Bold" size="12.0" />
      </font>
   </Label>
    <Button maxHeight="50.0" maxWidth="90.0" onAction="#btnConfirmar" prefHeight="30.0" text="Confirmar" />
</VBox>
