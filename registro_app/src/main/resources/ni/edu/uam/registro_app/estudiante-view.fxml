<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER_LEFT" prefWidth="350.0" spacing="8.0" style="-fx-background-color: #E0F7FA; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registro_app.controller.EstudianteController">
   <children>
      <Label text="Nombres:" />
      <TextField fx:id="txtNombre" promptText="Juan Alexander" />
      <Label fx:id="lblApellido" text="Apellido:" />
      <TextField fx:id="txtApellido" promptText="Rocha Gonzalez" />
      <Label text="Carrera:" />
      <TextField fx:id="txtCarrera" />
      <Label fx:id="lblFechaNac" text="Fecha de Nacimiento" />
      <DatePicker fx:id="dpFechaNacimiento" promptText="Seleccione fecha de Nacimiento" />
      <Label text="Departamento:" />
      <ComboBox fx:id="cbDepartamento" promptText="Seleccione departamento">
         <items>
            <FXCollections fx:factory="observableArrayList">
               <String fx:value="Managua" />
               <String fx:value="León" />
               <String fx:value="Chinandega" />
               <String fx:value="Masaya" />
               <String fx:value="Matagalpa" />
               <String fx:value="Jinotega" />
               <String fx:value="Estelí" />
               <String fx:value="Granada" />
            </FXCollections>
         </items>
      </ComboBox>

      <Label style="-fx-text-fill: #34495e;" text="Género:" />
      <fx:define>
         <ToggleGroup fx:id="grupoGenero" />
      </fx:define>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <RadioButton fx:id="rbMasculino" text="Masculino" toggleGroup="$grupoGenero" />
            <RadioButton fx:id="rbFemenino" text="Femenino" toggleGroup="$grupoGenero" />
         </children>
      </HBox>

      <CheckBox fx:id="chkTieneBeca" mnemonicParsing="false" text="Tiene Beca">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </CheckBox>
      <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#guardarOnClick" text="Agregar" />
      <Label fx:id="lblRegistro" text="Resgistro Guardado:" />
   </children>
</VBox>
